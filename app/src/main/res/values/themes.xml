<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CaffeShop" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/cafe_primary</item>
        <item name="colorOnPrimary">@color/cafe_on_primary</item>
        <item name="colorPrimaryContainer">@color/cafe_primary_container</item>
        <item name="colorSecondary">@color/cafe_secondary</item>
        <item name="colorSecondaryContainer">@color/cafe_secondary_container</item>
        
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/cafe_background</item>
        <item name="android:windowLightStatusBar">true</item>
        
        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/cafe_background</item>
        <item name="colorSurface">@color/cafe_surface</item>
        <item name="colorSurfaceVariant">@color/cafe_surface_variant</item>
    </style>

    <style name="Theme.CaffeShop" parent="Base.Theme.CaffeShop" />

    <!-- Style for primary filled buttons -->
    <style name="Widget.CaffeShop.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/cafe_text_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Style for secondary outlined buttons -->
    <style name="Widget.CaffeShop.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/cafe_text_primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/cafe_text_primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Style for Accent buttons (Orange/Caramel) -->
    <style name="Widget.CaffeShop.Button.Accent" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/cafe_secondary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
