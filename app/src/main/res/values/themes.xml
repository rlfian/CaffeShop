<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CaffeShop" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/cafe_espresso</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/cafe_caramel</item>
        <item name="colorOnSecondary">@color/white</item>
        
        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/cafe_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/cafe_surface</item>
        <item name="android:windowLightNavigationBar">true</item>
        
        <!-- Canvas Background -->
        <item name="android:colorBackground">@color/cafe_background</item>
        <item name="colorSurface">@color/cafe_surface</item>
    </style>

    <style name="Theme.CaffeShop" parent="Base.Theme.CaffeShop" />

    <!-- High-Contrast Primary Button (Wireframe filled black button) -->
    <style name="Widget.CaffeShop.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/cafe_espresso</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="elevation">2dp</item>
    </style>

    <!-- Outlined Button (Wireframe outline button) -->
    <style name="Widget.CaffeShop.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/cafe_espresso</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/cafe_espresso</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Accent Button (Caramel/Warm) -->
    <style name="Widget.CaffeShop.Button.Accent" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/cafe_caramel</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Clean Form Input Layout -->
    <style name="Widget.CaffeShop.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxStrokeColor">@color/cafe_espresso</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="hintTextColor">@color/cafe_caramel</item>
        <item name="android:textColorHint">@color/cafe_text_placeholder</item>
    </style>
</resources>
