<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="2dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="2dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/cafe_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/cafe_border"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Food Photo Box -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardImageHolder"
            android:layout_width="84dp"
            android:layout_height="84dp"
            app:cardBackgroundColor="@color/cafe_surface_subtle"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/cafe_border"
            app:strokeWidth="0.8dp">

            <ImageView
                android:id="@+id/ivFoodImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Foto Menu"
                android:padding="12dp"
                android:src="@drawable/ic_coffee_cup" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Badge Tag -->
        <TextView
            android:id="@+id/tvBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_badge_tag"
            android:fontFamily="sans-serif-bold"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:textColor="@color/cafe_badge_text"
            android:textSize="10.5sp"
            app:layout_constraintStart_toEndOf="@+id/cardImageHolder"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="⭐ Best Seller" />

        <!-- Favorite Heart Icon -->
        <ImageView
            android:id="@+id/ivFavorite"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Favorit"
            android:padding="5dp"
            android:src="@drawable/ic_heart"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Food Title -->
        <TextView
            android:id="@+id/tvFoodName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="6dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-bold"
            android:maxLines="1"
            android:textColor="@color/cafe_text_title"
            android:textSize="15.5sp"
            app:layout_constraintEnd_toStartOf="@+id/ivFavorite"
            app:layout_constraintStart_toEndOf="@+id/cardImageHolder"
            app:layout_constraintTop_toBottomOf="@+id/tvBadge"
            tools:text="Kopi Susu Gula Aren" />

        <!-- Food Description -->
        <TextView
            android:id="@+id/tvFoodDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="2"
            android:textColor="@color/cafe_text_muted"
            android:textSize="12.5sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cardImageHolder"
            app:layout_constraintTop_toBottomOf="@+id/tvFoodName"
            tools:text="• Espresso, susu, gula aren" />

        <!-- Price -->
        <TextView
            android:id="@+id/tvFoodPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/cafe_caramel"
            android:textSize="14.5sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cardImageHolder"
            app:layout_constraintTop_toBottomOf="@+id/tvFoodDescription"
            tools:text="• Rp 22.000" />

        <!-- Quick Order Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuickAdd"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:backgroundTint="@color/cafe_espresso"
            android:fontFamily="sans-serif-bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Pesan"
            android:textColor="@color/white"
            android:textSize="11.5sp"
            app:cornerRadius="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvFoodDescription" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
