<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    app:cardBackgroundColor="@color/cafe_surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0.5dp"
    app:strokeColor="@color/cafe_border"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Image Holder -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCartFoodHolder"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:cardBackgroundColor="@color/cafe_surface_subtle"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivCartFoodImg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Menu"
                android:padding="8dp"
                android:src="@drawable/ic_coffee_cup" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Name -->
        <TextView
            android:id="@+id/tvCartFoodName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/cafe_text_title"
            android:textSize="15sp"
            app:layout_constraintEnd_toStartOf="@+id/btnCartDelete"
            app:layout_constraintStart_toEndOf="@+id/cardCartFoodHolder"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Kopi Susu Gula Aren" />

        <!-- Options summary (Iced, Normal) -->
        <TextView
            android:id="@+id/tvCartOptions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/cafe_text_muted"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@+id/btnCartDelete"
            app:layout_constraintStart_toEndOf="@+id/cardCartFoodHolder"
            app:layout_constraintTop_toBottomOf="@+id/tvCartFoodName"
            tools:text="Iced • Normal Sugar" />

        <!-- Price -->
        <TextView
            android:id="@+id/tvCartPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/cafe_caramel"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cardCartFoodHolder"
            app:layout_constraintTop_toBottomOf="@+id/tvCartOptions"
            tools:text="Rp 22.000" />

        <!-- Delete button -->
        <ImageView
            android:id="@+id/btnCartDelete"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Hapus"
            android:padding="6dp"
            android:src="@drawable/ic_logout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Quantity Stepper -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCartMinus"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:backgroundTint="@color/cafe_surface_subtle"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="-"
                android:textColor="@color/cafe_espresso"
                android:textSize="14sp"
                app:cornerRadius="8dp" />

            <TextView
                android:id="@+id/tvCartQuantity"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/cafe_text_title"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCartPlus"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:backgroundTint="@color/cafe_surface_subtle"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="+"
                android:textColor="@color/cafe_espresso"
                android:textSize="14sp"
                app:cornerRadius="8dp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
