<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cafe_background"
    android:paddingStart="28dp"
    android:paddingTop="36dp"
    android:paddingEnd="28dp"
    android:paddingBottom="36dp">

    <!-- Top Greeting "Halo Nama," (Matches Wireframe 8) -->
    <TextView
        android:id="@+id/tvConfirmGreeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="serif"
        android:textColor="@color/cafe_text_title"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Halo Robby," />

    <!-- Center Confirmation Group -->
    <LinearLayout
        android:id="@+id/confirmCenterGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/confirmButtonGroup"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvConfirmGreeting"
        app:layout_constraintVertical_bias="0.45">

        <!-- Green Circle with "OK" Badge (Exact Wireframe 8) -->
        <FrameLayout
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:background="@drawable/bg_ok_circle">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-black"
                android:text="@string/confirmation_ok"
                android:textColor="@color/cafe_ok_text"
                android:textSize="38sp" />
        </FrameLayout>

        <!-- Wireframe 8 Message -->
        <TextView
            android:id="@+id/tvConfirmMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/confirmation_message"
            android:textColor="@color/cafe_text_title"
            android:textSize="17sp" />

        <!-- Order Estimate Chip -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipEstimate"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/estimated_time"
            android:textColor="@color/cafe_caramel"
            app:chipBackgroundColor="@color/cafe_caramel_light"
            app:chipStrokeWidth="0dp" />

    </LinearLayout>

    <!-- Bottom Buttons -->
    <LinearLayout
        android:id="@+id/confirmButtonGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Track Courier Button (Extended) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTrackOrder"
            style="@style/Widget.CaffeShop.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/btn_track_order" />

        <!-- Oke Button (Filled Black - Wireframe 8) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmOke"
            style="@style/Widget.CaffeShop.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_oke" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
