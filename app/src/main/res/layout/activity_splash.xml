<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cafe_background"
    android:paddingStart="28dp"
    android:paddingTop="36dp"
    android:paddingEnd="28dp"
    android:paddingBottom="36dp">

    <!-- Center Brand Emblem & Typography -->
    <LinearLayout
        android:id="@+id/brandGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/btnStartNow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45">

        <!-- Logo Circle Container -->
        <FrameLayout
            android:layout_width="160dp"
            android:layout_height="160dp">

            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_coffee_logo" />
        </FrameLayout>

        <!-- Brand Title: "Kopi dan Nyemil" -->
        <TextView
            android:id="@+id/tvBrandTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="serif"
            android:text="@string/brand_title"
            android:textColor="@color/cafe_text_title"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Tagline: "Get a taste of your wish" -->
        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/splash_tagline"
            android:textColor="@color/cafe_text_muted"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Start Now Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartNow"
        style="@style/Widget.CaffeShop.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/start_now"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
